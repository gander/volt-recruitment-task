{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>gander-settings/renovate"],
    "packageRules": [
        {
            "description": "Stay on the Symfony 8.x line: a major hop (9.x) is a planned upgrade, not an automatic update",
            "matchManagers": ["composer"],
            "matchPackageNames": ["symfony/*"],
            "allowedVersions": "<9"
        },
        {
            "matchManagers": ["composer"],
            "matchPackageNames": ["webmozart/assert", "doctrine/annotations"],
            "allowedVersions": "<2"
        }
    ]
}
